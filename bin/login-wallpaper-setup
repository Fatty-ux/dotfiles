#!/usr/bin/env bash
# One-time setup: make the login screen use your current desktop wallpaper.
# Works with Plasma Login Manager (CachyOS's default) and SDDM.
# After this, the bar keeps it in sync automatically whenever you change wallpaper.
#
# Plasma Login: the picture lives in /var/lib/plasmalogin/wallpapers/joeos-login.jpg (owned by
#   you so the bar can update it) and /etc/plasmalogin.conf points the greeter at it.
#   Undo: sudo cp /etc/plasmalogin.conf.joeos-backup /etc/plasmalogin.conf
# SDDM: the picture lives in /usr/local/share/joeos/login-wallpaper.jpg and the theme's
#   theme.conf.user points at it.  Undo: sudo rm <theme folder>/theme.conf.user

set -u
DIR=/usr/local/share/joeos
PIC="$DIR/login-wallpaper.jpg"
say()  { printf '\e[1;34m::\e[0m %s\n' "$*"; }
warn() { printf '\e[1;33m!!\e[0m %s\n' "$*"; }

# ---- your current wallpaper (from the bar's saved settings) ----
state="$HOME/.local/state/quickshell-pins.json"
wall="$(grep -o '"wallpaper": *"[^"]*"' "$state" 2>/dev/null | head -1 | sed 's/.*"wallpaper": *"//; s/"$//; s#^file://##')"
wall="$(printf '%b' "${wall//%/\\x}")"     # undo %20 etc.
copy_wall() {   # copy_wall <target file>: writes into the existing file, keeping its owner
    if [ -n "$wall" ] && [ -f "$wall" ]; then
        ffmpeg -v error -y -i "$wall" -frames:v 1 -q:v 2 /tmp/joeos-login.jpg && cat /tmp/joeos-login.jpg > "$1" \
            && rm -f /tmp/joeos-login.jpg && say "Copied your wallpaper: $wall"
    else
        warn "Couldn't find your current wallpaper; it'll be copied next time you change wallpaper."
    fi
}

# ---- which login screen? ----
dm="$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" .service)"
[ -z "$dm" ] && dm="none"

if [ "$dm" = "plasmalogin" ]; then
    say "Login screen: Plasma Login Manager"
    command -v kwriteconfig6 >/dev/null || { warn "kwriteconfig6 is missing:  sudo pacman -S kconfig"; exit 1; }
    WDIR=/var/lib/plasmalogin/wallpapers
    WPIC="$WDIR/joeos-login.jpg"
    # the picture: in the login screen's own folder, but owned by you so the bar can update it
    sudo mkdir -p "$WDIR"
    sudo chown plasmalogin:plasmalogin "$WDIR" 2>/dev/null
    sudo chmod 755 "$WDIR"
    sudo touch "$WPIC"
    sudo chown "$USER":plasmalogin "$WPIC"
    sudo chmod 644 "$WPIC"
    copy_wall "$WPIC"
    # the setting: straight into /etc/plasmalogin.conf (its .conf.d folder can get ignored)
    [ -f /etc/plasmalogin.conf ] && [ ! -f /etc/plasmalogin.conf.joeos-backup ] \
        && sudo cp /etc/plasmalogin.conf /etc/plasmalogin.conf.joeos-backup \
        && say "Saved the old settings to /etc/plasmalogin.conf.joeos-backup"
    sudo touch /etc/plasmalogin.conf
    sudo kwriteconfig6 --file /etc/plasmalogin.conf --group Greeter --key WallpaperPluginId org.kde.image
    sudo kwriteconfig6 --file /etc/plasmalogin.conf --group Greeter --group Wallpaper --group org.kde.image \
        --group General --key Image "file://$WPIC"
    sudo kwriteconfig6 --file /etc/plasmalogin.conf --group Greeter --group Wallpaper --group org.kde.image \
        --group General --key PreviewImage "file://$WPIC"
    sudo chmod 644 /etc/plasmalogin.conf
    say "Done! Your login screen now uses your wallpaper, and it'll follow every wallpaper change."
    say "To see it: log out (or restart)."
    exit 0
fi

if [ "$dm" != "sddm" ]; then
    warn "Your login screen is \"$dm\", which this script doesn't know yet."
    warn "Tell Claude it's \"$dm\" and it'll make a version for that."
    exit 1
fi
say "Login screen: SDDM"

# ---- which SDDM theme? (the last Current= wins, like SDDM itself reads them) ----
theme=""
for f in /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf /etc/sddm.conf; do
    [ -f "$f" ] || continue
    t="$(awk -F= '/^\[/{sec=$0} sec=="[Theme]" && $1~/^[ \t]*Current[ \t]*$/ {gsub(/[ \t]/,"",$2); print $2}' "$f" | tail -1)"
    [ -n "$t" ] && theme="$t"
done
if [ -z "$theme" ]; then
    warn "SDDM isn't set to a theme, so it uses its plain built-in look, which can't show a picture."
    warn "Installing the Breeze theme (it supports a background) and switching to it."
    sudo pacman -S --needed --noconfirm sddm-kcm >/dev/null 2>&1 || sudo pacman -S --needed --noconfirm breeze >/dev/null 2>&1
    sudo mkdir -p /etc/sddm.conf.d
    printf '[Theme]\nCurrent=breeze\n' | sudo tee /etc/sddm.conf.d/joeos-theme.conf >/dev/null
    theme="breeze"
fi
tdir="/usr/share/sddm/themes/$theme"
if [ ! -d "$tdir" ]; then
    warn "SDDM theme \"$theme\" is set, but its folder $tdir doesn't exist."
    warn "Tell Claude this and it'll sort it out."
    exit 1
fi
say "SDDM theme: $theme  ($tdir)"

# ---- a spot the login screen can read, that you own (so no password needed later) ----
sudo mkdir -p "$DIR"
sudo chown "$USER": "$DIR"
sudo chmod 755 "$DIR"

# ---- copy the current wallpaper in now ----
touch "$PIC" && chmod 644 "$PIC"
copy_wall "$PIC"

# ---- point the theme at it (theme.conf.user overrides the theme's own settings) ----
conf="$tdir/theme.conf.user"
if [ -f "$conf" ] && ! grep -q "joeos" "$conf"; then
    sudo cp "$conf" "$conf.joeos-backup"
    say "Saved the theme's old settings to $conf.joeos-backup"
fi
printf '[General]\n# set by JoeOS login-wallpaper-setup\nbackground=%s\nBackground=%s\ntype=image\n' "$PIC" "$PIC" | sudo tee "$conf" >/dev/null
sudo chmod 644 "$conf"

say "Done! Your login screen now uses your wallpaper, and it'll follow every wallpaper change."
say "To see it: log out (or restart)."
