#!/usr/bin/env bash
# fastfetch with a random Pokémon as the logo.
# Needs:  fastfetch  and  pokemon-colorscripts  (or krabby). Falls back to the normal logo without them.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

if command -v pokemon-colorscripts >/dev/null 2>&1; then
    pokemon-colorscripts -r --no-title > "$tmp" 2>/dev/null
elif command -v krabby >/dev/null 2>&1; then
    krabby random --no-title > "$tmp" 2>/dev/null
fi

if [ -s "$tmp" ]; then
    fastfetch --logo-type file-raw --logo "$tmp" --logo-padding-right 3 "$@"
else
    fastfetch "$@"
fi
