{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // JoeOS system info: short and tidy. Colours come from the terminal palette,
  // which Quickshell builds from the wallpaper (34 = blue = the wallpaper accent).
  "logo": {
    "padding": { "top": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 12 },
    "color": { "keys": "1;34", "title": "1;34", "separator": "90" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "─" },
    { "type": "os",     "key": "  OS",      "format": "JoeOS" },
    { "type": "cpu",    "key": "  CPU",     "format": "{name}" },
    { "type": "gpu",    "key": "  GPU",     "format": "{name}", "hideType": "integrated" },
    { "type": "memory", "key": "  RAM",     "format": "{used} / {total}  ({percentage})" },
    { "type": "disk",   "key": "  Storage", "folders": "/", "format": "{size-used} / {size-total}  ({size-percentage})" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
